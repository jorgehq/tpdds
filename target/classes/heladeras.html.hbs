{{# partial "contenido" }}
    <head>
      <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" type="text/css" href="assets/heladeras.css">
          <link rel="stylesheet" type="text/css" href="assets/general.css">

          <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
                integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
                crossorigin="anonymous">
      </head>
      <body >
    <h1 class="titulosPantallasSinLayout">Heladeras</h1>
      <form action="/heladeras" method="GET">
          <div class="row">
              <div class="col">
          <div class="form-floating">
              <select class="form-control" id="filtro" name="filtro" required>
                  <option value="0">Todas</option>
                  <option value="1">Nombre</option>
                  <option value="2">Localidad</option>
                  <option value="3">Direccion</option>
              </select>
              <label for="Filtro">Filtros</label>
          </div>
          </div>
          <div class="col">
              <div class="form-floating">
                  <input type="text" class="form-control" id="dato" name="dato" >
                  <label for="dato"></label>
              </div>
          </div>
              <div class="col">
                  <div id="botonSubmitFiltro" class="form-floating">
                      <input class="botonPrincipal" type="submit" value="Registrar">
                  </div>
              </div>
          </div>
      </form>

  <form action="/heladeras" method="POST">
      <section id="contenerdorHeladeras">
          <div class="fondoContenedor">
              <p>Lista de heladeras</p>
              <ul>
                  {{#each heladeras}}
                      <li>
                          <input type="checkbox" name="heladeraId" value="{{id}}" id="heladera{{id}}">
                          <label for="heladera{{id}}">Nombre: {{nombre}} | Ubicación: {{this.direccion.provincia}} {{this.direccion.localidad}} {{this.direccion.direccion}}</label>
                      </li>
                  {{#unless @last}}
                  <div class="lineaDivisoria"></div>
                  {{/unless}}
                  {{/each}}
              </ul>
          </div>
          <div class="row">
              <div class="col">
                  <div id="Botonsuscripcion" class="form-floating">
                      <input class="botonPrincipal" type="submit" value="Suscripcion">
                  </div>

            </div>

              <div class="col">
                  <div id="Botonreportar" class="form-floating">
                      <input class="botonPrincipal" type="submit" value="Reporte">
                  </div>
             </div>
         </div>
      </section>
  </form>
{{/partial}}

{{> BarraNavegacion.html }}
